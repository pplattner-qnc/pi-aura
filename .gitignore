# Local npm artifacts (the pi package itself has no runtime deps).
node_modules/
package-lock.json

# One-off profiler output (0x flamegraphs) — not repo content.
profiles/

# Generated build artifacts — keep only the digest-dashboard runtime bundles.
dist/**
!.pi/extensions/digest-dashboard/dist/app.js
!.pi/extensions/digest-dashboard/dist/app.css
!.pi/extensions/digest-dashboard/dist/server.mjs

# Impeccable skill install (per-env, from pi-impeccable)
.agents/

# Task-workflow runtime state
docs/tasks/state.yaml

# Subagent per-slice scratch outputs (tdd/verify/deviation/land/ui-noter results)
# — these are workflow artifacts, not repo content.
tdd-*/
verify-*/
deviation-*/
land-*/
ui-note-*/
