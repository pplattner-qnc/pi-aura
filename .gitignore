# Local npm artifacts (the pi package itself has no runtime deps).
node_modules/
package-lock.json

# One-off profiler output (0x flamegraphs) — not repo content.
profiles/

# Generated build artifacts. Committed runtime bundles stay tracked; new
# untracked ones are ignored.
dist/**

# Impeccable skill install (per-env, from pi-impeccable)
.agents/

# Subagent per-slice scratch outputs (tdd/verify/deviation/land/ui-noter results)
# at the repo root: these are workflow artifacts, not repo content. Anchored
# so they never match docs/tasks/**/ paths (e.g. deviation-reports/).
/tdd-*/
/verify-*/
/deviation-*/
/land-*/
/ui-note-*/
# Per-task workflow scratch (uncertainty notes, chain outputs under .work/).
.work/

# docs/tasks/state.yaml is TRACKED: the task/slice pointers and the
# schema_version stamp persist across clones so setup-workflow is idempotent.
