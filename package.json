{
  "name": "pi-aura",
  "version": "0.8.0",
  "description": "Aura integration for pi — skills, agents, and workflows for the Aura project management platform",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/aura-skill-instruction.ts",
      "./extensions/aura-secrets.ts",
      "./extensions/aura-tasks.ts",
      "./extensions/aura-feedback.ts",
      "./extensions/engineering-rules.ts",
      "./extensions/aura-references.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "workspaces": [
    "scripts",
    "packages/shared"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "*"
  }
}
